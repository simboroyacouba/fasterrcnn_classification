# =============================================================================
# Configuration Faster R-CNN - Détection Toitures Cadastrales
# =============================================================================

# Fichier de classes (partagé avec YOLO)
CLASSES_FILE=classes.yaml

# =============================================================================
# DATASET
# =============================================================================

# Dataset complet (mode all)
DETECTION_DATASET_IMAGES_DIR=C:/Users/NEBRATA/Desktop/Memoire/Donnees/classification/dataset_all
DETECTION_DATASET_ANNOTATIONS_FILE=C:/Users/NEBRATA/Desktop/Memoire/Donnees/classification/dataset_all/instances_default.json

# Dataset nadir (Production_*.png)
NADIR_ANNOTATIONS_FILE=/kaggle/input/datasets/simboroyacouba/datasetclassification/instances_nadir.json
NADIR_CLASSES_FILE=classes_nadir.yaml

# Dataset oblique (Snapshot_*.jpg)
OBLIQUE_ANNOTATIONS_FILE=/kaggle/input/datasets/simboroyacouba/datasetclassification/instances_oblique.json
OBLIQUE_CLASSES_FILE=classes_oblique.yaml

# Dossier des images pour inférence
DETECTION_INFERENCE_IMAGES_DIR=C:/Users/NEBRATA/Desktop/Memoire/donnees/classification/inference

# =============================================================================
# ENTRAÎNEMENT
# =============================================================================

# NUM_EPOCHS=50
# BATCH_SIZE=2
# LEARNING_RATE=0.005
# # CosineAnnealingLR : decroit de LEARNING_RATE jusqu'a 1e-5 sur NUM_EPOCHS
# MOMENTUM=0.9
# WEIGHT_DECAY=0.0005
# IMAGE_SIZE=1280
# TRAIN_SPLIT=0.70
# VAL_SPLIT=0.20
# TEST_SPLIT=0.10
# SAVE_EVERY=5



NUM_EPOCHS=25
BATCH_SIZE=2
LEARNING_RATE=0.00634
# CosineAnnealingLR : decroit de LEARNING_RATE jusqu'a 1e-5 sur NUM_EPOCHS
MOMENTUM=0.9681
WEIGHT_DECAY=0.000155
IMAGE_SIZE=1280
TRAIN_SPLIT=0.70
VAL_SPLIT=0.20
TEST_SPLIT=0.10
SAVE_EVERY=5

# Utiliser les poids pré-entraînés COCO (true recommandé)
PRETRAINED=true

# Seuil de confiance pour les prédictions
SCORE_THRESHOLD=0.6

# =============================================================================
# SORTIE
# =============================================================================

OUTPUT_DIR=./runs/detect/train
EVALUATION_DIR=./evaluation
PREDICTIONS_DIR=./predictions

# Chemin vers un modèle existant (pour evaluate.py et inference.py)
# Laisser vide pour auto-détection
MODEL_PATH=
